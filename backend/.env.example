# Backend local environment for DuckHat
SERVER_PORT=8081
SPRING_DATASOURCE_URL='jdbc:mysql://localhost:3307/duckhat?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo'
SPRING_DATASOURCE_USERNAME=duckhat_user
SPRING_DATASOURCE_PASSWORD=duckhat_pass
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
JWT_SECRET=ZHVja2hhdC1zdXBlci1zZWNyZXQta2V5LWR1Y2toYXQtMjAyNi1zZWd1cmE=
JWT_EXPIRATION=3600000
APP_AUTH_RETURN_RESET_CODE=false

# Recuperação de senha por e-mail SMTP.
# Para teste local sem SMTP, use APP_AUTH_RETURN_RESET_CODE=true.
APP_EMAIL_ENABLED=true
APP_EMAIL_HOST=
APP_EMAIL_PORT=587
APP_EMAIL_USERNAME=
APP_EMAIL_PASSWORD=''
APP_EMAIL_FROM=no-reply@duckhat.local
APP_EMAIL_FROM_NAME=DuckHat
APP_EMAIL_AUTH=true
APP_EMAIL_SSL=false
APP_EMAIL_START_TLS=true
APP_EMAIL_CONNECT_TIMEOUT_MS=10000
APP_EMAIL_READ_TIMEOUT_MS=10000
